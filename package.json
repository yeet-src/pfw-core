{
  "name": "pfw-core",
  "version": "0.1.0",
  "private": true,
  "description": "The programmable-firewall VM: ISA, pfw-C compiler, bytecode, and a reference interpreter, with an eBPF/XDP backend.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#/asm": "./src/asm/index.js",
    "#/builder": "./src/builder/index.js",
    "#/bytes": "./src/bytes/index.js",
    "#/clang": "./src/clang/index.js",
    "#/huffman": "./src/huffman/index.js",
    "#/program": "./src/program/index.js",
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.js",
    "./asm": "./src/asm/index.js",
    "./builder": "./src/builder/index.js",
    "./bytes": "./src/bytes/index.js",
    "./clang": "./src/clang/index.js",
    "./huffman": "./src/huffman/index.js",
    "./loader": "./src/loader.js",
    "./program": "./src/program/index.js",
    "./*": "./src/*"
  },
  "scripts": {
    "test": "npm run test:node && npm run test:isa && npm run test:unit",
    "test:isa": "yeet test test/isa",
    "test:unit": "yeet test test/unit",
    "test:node": "node test/node/check-isa.mjs && node test/node/examples.mjs && node test/node/examples-behavior.mjs",
    "test:verify": "yeet run scripts/verify-load.mjs",
    "test:kernel": "node test/kernel/diff.mjs",
    "gen:huff": "node scripts/gen-huff.mjs",
    "bpf": "make bpf",
    "package": "make package",
    "test:rewrite": "node test/kernel/rewrite.mjs",
    "test:dnat": "node test/kernel/dnat.mjs",
    "test:lpm": "node test/kernel/lpm.mjs",
    "test:regex": "node test/kernel/regex.mjs",
    "test:hash": "node test/kernel/hash.mjs",
    "test:bloom": "node test/kernel/bloom.mjs",
    "test:lpm6": "node test/kernel/lpm6.mjs",
    "test:redirect": "node test/kernel/redirect.mjs",
    "test:rate": "node test/kernel/rate.mjs",
    "test:argv": "node test/kernel/argv.mjs",
    "test:regex-rewrite": "node test/kernel/regex-rewrite.mjs",
    "test:shadow": "node test/kernel/shadow.mjs",
    "test:console": "node test/kernel/console.mjs",
    "test:printk": "node test/kernel/printk.mjs",
    "test:stack": "node test/kernel/stack.mjs",
    "test:call": "node test/kernel/call.mjs",
    "test:args": "node test/kernel/args.mjs",
    "test:source": "node test/kernel/source.mjs",
    "test:nat": "node test/kernel/nat.mjs",
    "test:reasm": "node test/kernel/reasm.mjs",
    "test:h2": "node test/kernel/h2.mjs",
    "test:examples-kernel": "node test/kernel/examples.mjs",
    "test:loader": "node test/kernel/loader.mjs",
        "test:knob": "node test/kernel/knob.mjs",
    "test:kstr": "node test/kernel/kstr.mjs",
    "test:mpos": "node test/kernel/mpos.mjs",
    "test:lang": "node test/kernel/lang.mjs"
  }
}
