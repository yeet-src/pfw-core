// Geo / ASN policy with a tarpit. Internal ranges bypass policy entirely; sources
// in a host-loaded CIDR trie (a country or hostile-ASN prefix list, updated out of
// band) are not hard-blocked but tarpitted — a slow trickle is allowed via a token
// bucket, and a source that keeps hammering from a blocked region earns an
// hour-long ban. Everything is traced for the SOC.
//
// Combines: inline CIDR bypass (`src in "..."`), a host-loaded LPM `set`, a
// per-source token bucket rate(), src.count escalation, ban, and console().
filter {
  // trusted internal networks are never geo-filtered
  if (src in "10.0.0.0/8") decide pass;
  if (src in "192.168.0.0/16") decide pass;
  if (src in "172.16.0.0/12") decide pass;

  // not in the blocked-region set? allow.
  if (src in set) {
    let strikes = src.count;                 // one read: every read increments
    console("geo src in blocked set sport=%d strikes=%d", sport, strikes);
    // tarpit: a handful of requests slip through; sustained volume is banned
    if (rate(2, 5)) {
      log(1);
      if (strikes >= 10) decide ban("geo_abuse", 3600);
      decide drop("geo_rate");
    }
    decide pass;
  }

  decide pass;
}
