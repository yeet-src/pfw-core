// A request-line tokenizer — a mini parser at XDP. Splits "METHOD SP PATH SP
// VERSION" with the forward cursor, pushing each field's start offset onto the
// data stack as it goes, then pops them back (LIFO) to apply a per-token policy:
// a method allowlist, a path gate, and a required protocol version. Showcases the
// cursor (find/skip/starts), the data stack as a token buffer, and starts() used
// on a popped offset to probe a field in place.
nocase;
reassemble 8080;
pattern m_get = "GET ", m_post = "POST ", m_head = "HEAD ";
pattern admin = "/admin", version = "HTTP/1.";
filter {
  if (dport != 8080) decide pass;
  if (len == 0) decide pass;

  push(payload);                         // token 0: method start
  ptr a = find(payload, ' ', 8); skip(a, ' ');
  push(a);                               // token 1: path start
  ptr b = find(a, ' ', 2048); skip(b, ' ');
  push(b);                               // token 2: version start

  let vstart = pop();                    // LIFO: version, then path, then method
  let pstart = pop();
  let mstart = pop();

  let ok = 0;
  if (starts(mstart, m_get)) ok = 1;
  if (starts(mstart, m_post)) ok = 1;
  if (starts(mstart, m_head)) ok = 1;
  if (ok == 0) decide drop("method_not_allowed");

  if (!starts(vstart, version)) decide drop("bad_http_version");
  if (starts(pstart, admin)) decide rst("admin_probe", 0);
  count("tokenized");
  decide pass;
}
