// Citrix Bleed (CVE-2023-4966): session-token memory disclosure on NetScaler
// ADC/Gateway. The exploit requests the OpenID configuration endpoint with a
// Host header padded to ~24 KB; the appliance formats its reply into a fixed
// buffer and sends back whatever lay beyond it — live session tokens.
//
// Deploy on a PLAINTEXT hop (behind whatever terminates TLS, here :8080): on
// :443 the path and headers are ciphertext and nothing below can match.
//
// The signal is the endpoint together with an abnormal Host header, and the Host
// header is MEASURED with the cursor, not guessed from the packet size: from the
// end of "Host:" to the CR that ends the line. A hostname cannot exceed 255
// bytes; anything longer on this endpoint is the exploit. The reassembly window
// is 4096 bytes, so a 24 KB header is never seen whole — it shows up as a Host
// line with no CR inside the window, which counts as oversized too.
// One hit resets; a source that repeats it (a harvest loop) is banned.
nocase;
reassemble 8080;
pattern endpoint = "/oauth/idp/.well-known/openid-configuration";
pattern host = "\r\nhost:", cr = "\r";

filter {
  if (proto != 6) decide pass;
  if (dport != 8080) decide pass;
  mask m = scan(payload, 4096);
  if (!all(m, endpoint, host)) decide pass;

  ptr h = after(host);                    // first byte of the Host value
  let e = find(h, '\r', 4096);            // the CR ending the line (cursor stays put on a miss)
  let n = e - h;
  let oversized = 0;
  if (n > 255) oversized = 1;
  if (e == h) { if (!starts(h, cr)) oversized = 1; }   // no CR in the window: runs past it
  if (oversized == 0) decide pass;

  log(1);
  console("citrix bleed probe: host header %d bytes sport=%d", n, sport);
  if (src.count >= 3) decide ban("citrix_bleed_repeat", 7200);   // harvest loop, any connection
  decide rst("citrix_bleed", 0);
}
