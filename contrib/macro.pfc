// Reusable rule blocks with `macro`: factor a common guard sequence and invoke
// it by name. Macros expand inline at compile time (there are no calls on the
// forward-only machine), so they are pure source-level convenience — the emitted
// bytecode is identical to writing the statements out by hand.
nocase;
pattern bot = "GPTBot", claudebot = "ClaudeBot", bytespider = "Bytespider";

// Shared preamble: drop out of anything that isn't inbound HTTP.
macro only_http {
  if (proto != 6) decide pass;
  if (dport != 80) decide pass;
}

filter {
  only_http;                            // expands to the two guards above
  if (scan(payload, 1460) & (bot | claudebot | bytespider)) decide rst("crawler", 60);
  decide pass;
}
