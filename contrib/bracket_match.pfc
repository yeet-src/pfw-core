// Balanced-delimiter checker — a stack verifier at XDP. Walks the body pushing on
// every '(' and popping on every ')', in byte order. Two failure modes mean a
// malformed or injection-crafted request: a ')' with an empty stack (close with
// no open — underflow) or opens left unclosed at the end (%sp > 0). Unbalanced
// delimiters are a classic signature of broken parsers and injection payloads.
// Showcases the data stack as a verifier (push/pop + %sp), with underflow caught.
reassemble 8080;
pattern op = "(", cp = ")";
filter {
  if (dport != 8080) decide pass;
  if (len == 0) decide pass;
  ptr p = payload; let big = 1000000; let bad = 0;
  repeat (80) {
    let o = find(p, '(', 4096); if (o == p) { if (!starts(p, op)) o = big; }
    let c = find(p, ')', 4096); if (c == p) { if (!starts(p, cp)) c = big; }
    if (o < big) {
      if (o <= c) { push(1); p = o + 1; }
      else { if (sp > 0) { let d = pop(); } else { bad = 1; } p = c + 1; }
    } else {
      if (c < big) { if (sp > 0) { let d = pop(); } else { bad = 1; } p = c + 1; }
    }
  }
  if (bad == 1) decide drop("unbalanced_close");
  if (sp > 0) decide drop("unclosed_opens");
  decide pass;
}
