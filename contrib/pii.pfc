// PII detection with fuzzy (regex) matching. `regex` patterns compile to a DFA
// that `scan` runs alongside the literal Aho-Corasick automaton — so one scan
// catches both exact strings and structured patterns. Here: reset any request
// carrying an SSN, an email, or a credit-card-shaped number. Char classes and
// bounded quantifiers only (no backtracking), so it runs at XDP.
nocase;
regex ssn   = "\d{3}-\d{2}-\d{4}";
regex email = "[a-z0-9._]+@[a-z0-9.]+\.[a-z]+";
regex card  = "\d{13,16}";
filter {
  if (dport != 80) decide pass;
  if (any(scan(payload, 1460), ssn, email, card)) decide rst("pii", 0);
  decide pass;
}
