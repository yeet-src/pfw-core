// Guard MongoDB (:27017). The trusted app tier passes; from the public internet,
// the tell-tale unauthenticated handshake/info probes (isMaster/hello, buildInfo,
// listDatabases) are the fingerprint of internet-wide Mongo scans that pillage open
// databases — those escalate to a ban, and anything else public is dropped anyway.
//
// Combines: a CIDR-membership subroutine, a recon-probe classification subroutine,
// reassembly, src.count escalation, and console()/log().
nocase;
reassemble 27017;
pattern ismaster = "ismaster", hello2 = "hello", buildinfo = "buildinfo";
pattern listdb = "listdatabases", getcmdline = "getcmdlineopts";

fn is_internal() {
  if (src in "10.0.0.0/8") return 1;
  if (src in "192.168.0.0/16") return 1;
  return 0;
}

fn is_recon(p) {
  mask m = scan(p, 512);
  if (any(m, ismaster, hello2)) return 1;             // handshake fingerprint
  if (any(m, buildinfo, listdb, getcmdline)) return 1; // info-disclosure probes
  return 0;
}

filter {
  if (proto != 6) decide pass;
  if (dport != 27017) decide pass;
  if (is_internal()) decide pass;             // trusted app tier

  if (is_recon(payload)) {
    let strike = src.count;
    console("mongo recon public strike=%d", strike);
    if (strike >= 2) decide ban("mongo_scanner", 3600);
    decide drop("mongo_probe");
  }
  decide drop("mongo_public");
}
