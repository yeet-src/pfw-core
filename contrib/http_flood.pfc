// Per-connection HTTP flood control. A single keep-alive connection pipelining
// thousands of requests is a cheap L7 DoS. `rate(per_sec, burst)` is a token
// bucket kept in the flow: allow a burst, then a steady rate; `rate(...)` is true
// when the connection is over budget. We also stash each request's size on the
// per-flow ring to spot a machine-gun cadence, and escalate from dropping the
// excess to banning a connection that just won't quit.
//
// Combines: reassembly, the token bucket (rate), the per-flow ring (cadence),
// let/arithmetic, flow.count escalation, console(), and drop/ban.
reassemble 8080;
filter {
  if (proto != 6) decide pass;
  if (dport != 8080) decide pass;
  if (len == 0) decide pass;              // pure ACKs cost nothing

  ring.push(len);
  let recent = ring.get(0) + ring.get(1) + ring.get(2);  // bytes in the last 3 requests

  if (rate(10, 20)) {                     // >10 req/s sustained past a burst of 20
    let over = flow.count;
    log(2);
    console("http flood :%d over=%d recent=%d", sport, over, recent);
    if (over >= 50) decide ban("http_flood", 600);
    decide drop("too_fast");
  }
  decide pass;
}
