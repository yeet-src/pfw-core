// HashDoS guard. Submitting thousands of parameter keys chosen to collide in the
// server's hash table turns O(1) inserts into O(n), freezing the worker on a tiny
// request (CVE-2011-4815 and friends). As a proxy for distinct keys this counts
// '=' (key=value) separators with a bounded loop; the starts()-disambiguated count
// is exact even for adjacent "====" runs. A pathological count is banned, a merely
// excessive one dropped.
reassemble 8080;
pattern eqp = "=";
filter {
  if (dport != 8080) decide pass;
  if (len == 0) decide pass;
  let big = 1000000;
  ptr p = payload; let keys = 0;
  repeat (160) { let o = find(p, '=', 2048); if (o == p) { if (!starts(p, eqp)) o = big; } if (o < big) { keys = keys + 1; p = o + 1; } }
  if (keys > 120) { log(1); decide ban("hashdos", 600); }
  if (keys > 40) decide drop("too_many_keys");
  decide pass;
}
