// Log4Shell (CVE-2021-44228): block the JNDI lookup strings that trigger remote
// class loading in vulnerable Log4j. The payload hides in ANY request field a
// server might log — User-Agent, headers, URI, body — so we scan the whole
// reassembled request, case-insensitively, for the lookup markers. Catching it
// at the NIC means the string never reaches the application's logger.
//
// Combines: reassembly, nocase, a single multi-pattern scan, any().
nocase;
reassemble 8080;
pattern jndi = "${jndi:", ldap = "${jndi:ldap", rmi = "${jndi:rmi", dns = "${jndi:dns";
pattern lower = "${lower:", upper = "${upper:", env = "${env:";   // obfuscation nests
filter {
  if (proto != 6) decide pass;
  mask m = scan(payload, 4096);
  if (any(m, jndi, ldap, rmi, dns)) { log(1); decide drop("log4shell"); }
  if (any(m, lower, upper, env)) { log(1); decide drop("log4shell_obf"); } // nested ${lower:j}ndi
  decide pass;
}
