// Struts2 OGNL RCE (S2-045 CVE-2017-5638 and S2-057 CVE-2018-11776). S2-045 puts
// an OGNL expression in the Content-Type header (`%{(#_memberAccess=...).exec}`);
// S2-057 puts it in the URL namespace. Both end in OGNL that disables the member-
// access sandbox and calls Runtime. The sandbox-escape token `#_memberAccess` and
// `@java.lang.Runtime@` are the high-confidence markers; `%{`/`#context` and the
// OGNL-util/opensymphony classes add weight.
//
// Non-trivial: scored over the whole reassembled request (so it catches the
// header-borne and URL-borne variants alike) with reset-then-ban escalation.
nocase;
reassemble 8080;
pattern ognl = "%{", ctx = "#context", mem = "#_memberaccess", rt = "@java.lang.runtime@";
pattern sym = "com.opensymphony", util = "ognlutil", multi = "multipart/form-data";

fn score() {
  mask m = scan(payload, 4096);
  let s = 0;
  if (any(m, mem, rt)) s = s + 3;     // sandbox escape + Runtime
  if (any(m, sym, util)) s = s + 2;   // Struts/OGNL internals being driven
  if (any(m, ognl, ctx)) s = s + 1;   // the OGNL expression wrapper
  if (any(m, multi)) s = s + 1;       // S2-045 rides multipart parsing
  return s;
}

filter {
  if (proto != 6) decide pass;
  let s = score();
  if (s >= 3) {
    log(1);
    if (src.count >= 2) decide ban("struts_ognl", 3600);
    decide rst("struts_ognl", 0);
  }
  decide pass;
}
