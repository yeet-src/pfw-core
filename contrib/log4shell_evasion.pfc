// Log4Shell, obfuscated (CVE-2021-44228 — evasion variants). A literal "${jndi:"
// filter is trivially bypassed by Log4j's own nested interpolation:
// `${${lower:j}ndi:...}`, `${${::-j}ndi:...}`, `${env:FOO:-j}ndi`, `${sys:x}`.
// Rather than chase every permutation, this scores the DENSITY of nested-lookup
// gadgets together with any jndi trace and the fetch scheme — a request stuffed
// with `${lower:}`/`${::-}`/`${env:}` wrappers around a URL is almost never real.
//
// Non-trivial: a weighted heuristic over the whole case-folded request, distinct
// from the plain log4shell rule; confident hits reset and ban.
nocase;
reassemble 8080;
pattern jndi = "jndi", scheme = "://";
pattern lower = "${lower:", upper = "${upper:", env = "${env:";
pattern sysp = "${sys:", colon = "${::-", date = "${date:";
pattern ldap = "ldap:", rmi = "rmi:", dnsp = "dns:", iiop = "iiop:";

fn score() {
  mask m = scan(payload, 2048);
  let s = 0;
  if (any(m, jndi)) s = s + 2;                                 // jndi trace
  if (any(m, lower, upper, env, sysp, colon, date)) s = s + 2; // obfuscation gadgets
  if (any(m, ldap, rmi, dnsp, iiop)) s = s + 2;                // the fetch scheme
  if (any(m, scheme)) s = s + 1;
  return s;
}

filter {
  if (proto != 6) decide pass;
  let s = score();
  if (s >= 4) {
    log(1);
    if (src.count >= 2) decide ban("log4shell_evasion", 3600);
    decide rst("log4shell_evasion", 0);
  }
  decide pass;
}
