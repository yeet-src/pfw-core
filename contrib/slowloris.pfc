// Slowloris: hold many connections open by trickling partial headers, never
// sending the blank line that ends them, exhausting the server's connection
// pool. The signature is a connection that keeps sending tiny segments and never
// completes its headers. We run a small per-flow state machine: a completed
// request (sees the CRLFCRLF terminator) clears suspicion; a stream of sub-64-byte
// dribbles without a terminator arms it and counts strikes, and enough drips bans
// the source.
//
// Combines: reassembly, cursor scan for the header terminator, per-flow state
// machine (flow.state) + strike counter (flow.count), arithmetic on len, console().
reassemble 8080;
pattern end_hdr = "\r\n\r\n";
filter {
  if (proto != 6) decide pass;
  if (dport != 8080) decide pass;
  if (len == 0) decide pass;

  // a completed request is normal traffic: clear any suspicion and pass
  if (scan(payload, 4096) & end_hdr) {
    flow.state = 0 for 1;
    decide pass;
  }

  // a tiny segment that doesn't finish the headers is a slowloris drip
  if (len < 64) {
    let drips = flow.count;
    log(4);
    console("slowloris drip :%d len=%d drips=%d", sport, len, drips);
    flow.state = 1 for 60;
    if (drips >= 20) decide ban("slowloris", 600);
    decide pass;                    // let it dribble while we build the case
  }
  decide pass;
}
