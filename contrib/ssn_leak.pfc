// SSN egress DLP with two layers: scrub fixed-shape SSNs out of every response in
// place (so a stray number never leaves), AND block outright when a response looks
// like a bulk record dump (PII context + many emails = someone exfiltrating a
// table, not one number in a form).
//
// Combines: fixed-length regex redact() in place + variable-signal detection to
// block, a correlation subroutine (emails && SSN context), per-flow counting,
// and console() observability. Response side (sport 80/8080) on a gateway.
// Plaintext hop only: this must sit BEHIND the TLS terminator. On :443 the payload
// is ciphertext and nothing here can match.
// Response side: `src` here is the SERVER, so this never bans — a source ban would
// blocklist your own web tier. It cuts the leaking response and counts it.
nocase;
regex ssn   = "\d{3}-\d{2}-\d{4}";                  // 123-45-6789 (fixed 11 -> redact)
regex email = "[a-z0-9._]+@[a-z0-9.]+\.[a-z]+";      // variable -> detect only
pattern ctx = "ssn", ctx2 = "social", ctx3 = "dob";

// a response pairing PII context with emails is a record export, not a stray field
fn is_record_dump() {
  mask m = scan(payload, 1460);
  if (any(m, email) && any(m, ctx, ctx2, ctx3)) return 1;
  return 0;
}

filter {
  if (proto != 6) decide pass;
  if (sport != 80 && sport != 8080) decide pass;
  if (len == 0) decide pass;

  // layer 1: always scrub fixed-shape SSNs in place (checksum fixed up for us)
  // (a bare 9-digit run is NOT scrubbed: that shape is also every timestamp, id
  // and Content-Length, and rewriting those corrupts the response)
  redact(ssn);

  // layer 2: a bulk dump is exfil — cut the response
  if (is_record_dump()) {
    let hits = flow.count;
    console("pii record dump sport=%d hit=%d", sport, hits);
    decide rst("ssn_dump", 0);
  }
  decide pass;
}
