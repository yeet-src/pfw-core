// Anchor a scan after a marker (P1 `after`): jump the cursor to just past the
// "Host:" header and match a blocked domain in the bytes that follow.
//
// `after(pat)` returns a pointer one byte past where `pat` matched, so the
// subsequent scan window starts at the header value instead of re-walking the
// whole payload. `reassemble` means the program sees the coalesced request
// stream, so the header isn't split across packet boundaries.
nocase;
reassemble 8080;
pattern host = "host:", badsite = "tracker.example";
filter {
  if (dport != 8080) decide pass;
  ptr h = after(host);                   // cursor just past "Host:"
  if (within(h, 256) & badsite) decide ban("blocked_host", 3600);   // within: only what follows Host:
  decide pass;
}
