// Anti-spoofing / bogon filter with escalation (edge ingress ACL). On a WAN
// interface, a packet whose SOURCE claims an RFC1918/loopback/link-local range —
// or sits in a host-loaded bogon/martian set — is forged. Rather than a bare
// drop, this classifies the source once (a subroutine returns a bogon class),
// escalates a repeat spoofer from a single-packet drop to a source-wide ban, and
// traces decisions to the host for the SOC.
//
// Combines: inline v4 CIDR tests + a host-loaded `set` (LPM trie), a subroutine
// with a return value, per-source escalation via flow.count, ban with a TTL, and
// console() observability. Deploy on the external ifindex.
nocase;

// Classify the source: 0 = clean, else a bogon class code. One place to edit.
fn bogon_class() {
  if (src in "10.0.0.0/8")     return 1;
  if (src in "172.16.0.0/12")  return 1;
  if (src in "192.168.0.0/16") return 1;
  if (src in "127.0.0.0/8")    return 2;   // loopback as a source on the wire
  if (src in "169.254.0.0/16") return 3;   // link-local
  if (src in "0.0.0.0/8")      return 4;   // "this network"
  if (src in set)              return 5;   // host-loaded martian / bogon trie
  return 0;
}

filter {
  let cls = bogon_class();
  if (cls == 0) return pass;

  // A source that keeps spoofing is not a fluke — escalate to an hour-long ban
  // after a handful of forged packets; log every decision for correlation.
  console("spoof class=%d sport=%d strikes=%d", cls, sport, flow.count);
  log(1);
  if (flow.count >= 4) return ban("spoof_repeat", 3600);
  return drop("bogon_source");
}
