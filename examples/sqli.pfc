// SQL injection, scored. One scan of the request feeds three STRONG signals:
//   UNION ... SELECT            (regex: any mix of space, '+', %20, /**/ between)
//   a boolean tautology         (`or 1=1`, `' or '1'='1`, raw or %-encoded)
//   a time-based blind probe    (`and sleep(5)`, `waitfor delay`, ...)
// and one WEAK one: a comment terminator (`--`, `/*`) — counted only when a
// strong signal is already present AND the terminator sits in the first line of
// the window (the request line).
// On its own, or anywhere else, it means nothing: `Accept: */*` contains `/*`
// and a multipart boundary is a run of `-`. after() gives the position of a
// pattern's first match, and the cursor finds the end of that line, so "is it
// in the URL" is one comparison.
//
// Nothing strong -> pass. One strong signal -> reset the connection and give the
// SOURCE a strike; three strikes, or a score of 3+ in one request (two strong
// signals, or one plus a terminator in the URL), -> ban the source address.
//
// Scope: signatures over the reassembled client stream (a sliding 4096-byte
// window) on a plaintext hop (behind the TLS terminator). It does not URL-decode — the regexes spell out
// the common encodings — so a doubly-encoded or otherwise obfuscated payload gets
// past it. A net in front of parameterised queries, not a substitute for them.
//
// Shows: reassembly, nocase, regexes sharing the scan mask with literals,
// after() positions compared against a cursor, per-source strikes (src.count),
// console/log, rst vs ban.
nocase;
reassemble 8080;
regex union_select = "union([\s+]|%20|%09|%0a|%0d|/\*\*/)+(all([\s+]|%20)+)?select";
regex tautology    = "('|%27|[\s+]|%20)or([\s+]|%20)+[0-9]+([\s+]|%20)*(=|%3d)([\s+]|%20)*[0-9]";
regex quote_or     = "('|%27)([\s+]|%20)*or([\s+]|%20)*('|%27)\w{0,8}('|%27)([\s+]|%20)*(=|%3d)";
regex blind        = "(and|or|select|when|then)([\s+(]|%20|%28)+(pg_sleep|sleep|benchmark)(\(|%28)";
regex waitfor      = "waitfor([\s+]|%20)+delay";
pattern c_dash = "--", c_block = "/*";

filter {
  if (proto != 6) decide pass;
  if (dport != 8080) decide pass;
  if (len == 0) decide pass;

  mask m = scan(payload, 4096);
  let score = 0;
  if (any(m, union_select)) score = score + 2;
  if (any(m, tautology, quote_or)) score = score + 2;
  if (any(m, blind, waitfor)) score = score + 2;
  if (score == 0) decide pass;

  // corroboration: a comment terminator inside the first (request) line
  ptr eol = find(payload, '\r', 4096);
  let term = 0;
  if (any(m, c_dash)) { let at = after(c_dash); if (at <= eol) term = 1; }
  if (any(m, c_block)) { let at = after(c_block); if (at <= eol) term = 1; }
  score = score + term;

  let strikes = src.count;                  // this source's strikes, on any connection
  console("sqli score=%d strikes=%d sport=%d", score, strikes, sport);
  log(1);
  if (score >= 3) decide ban("sqli_high_confidence", 1800);
  if (strikes >= 3) decide ban("sqli_repeat", 1800);
  decide rst("sqli", 0);
}
