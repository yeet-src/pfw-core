// DNS tunneling / exfiltration detector. Walks the QNAME of a DNS query label by
// label (each label is a length byte followed by that many bytes) with a `frame`
// loop starting just past the 12-byte DNS header, and measures the name: one
// abnormally long label, too many labels, or an oversized name overall are what
// base32/hex data smuggled into subdomain labels looks like.
//
// The walk stops at the root label (length 0) — or at a length byte >= 64, which
// is a compression pointer or garbage — so the QTYPE/QCLASS and any EDNS record
// that follow the name are never mistaken for labels. Only the first question is
// measured. The thresholds are heuristics: legitimate names with a 51+ byte
// label or 16+ labels exist (rarely), so run it shadowed before enforcing.
//
// Shows: UDP, pointer arithmetic to skip a fixed header, `frame` walking
// length-prefixed records, a stop flag and accumulators across the unrolled loop.
filter {
  if (proto != 17) decide pass;
  if (dport != 53) decide pass;
  if (len < 13) decide pass;

  let q = payload + 12;                 // the question section, past the DNS header
  let labels = 0;
  let longest = 0;
  let total = 0;
  let done = 0;

  frame at (q) (len = u8 @ 0, head = 1) up to 24 {
    if (done == 0) {
      if (frame.len == 0) done = 1;              // root label: the name ends here
      else if (frame.len >= 64) done = 1;        // compression pointer / not a label
      else {
        labels = labels + 1;
        total = total + frame.len;
        if (frame.len > longest) longest = frame.len;
      }
    }
  }

  if (longest > 50) { log(1); console("dns tunnel: label %d bytes", longest); decide drop("dns_tunnel_label"); }
  if (labels > 15)  { log(1); decide drop("dns_tunnel_labels"); }
  if (total > 150)  { log(1); decide drop("dns_tunnel_size"); }
  count("dns_query");
  decide pass;
}
