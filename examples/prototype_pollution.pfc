// Block JavaScript prototype-pollution payloads (CVE-class across Node/JS apps):
// a request that plants __proto__, constructor.prototype, or bracketed
// constructor[...] / prototype[...] keys into a parsed object can corrupt every
// object in the app and escalate to RCE. The tell is these keys in a JSON/body
// context. This narrows to the request body (past the headers) to avoid matching a
// legitimate "__proto__" discussed in a text field header, correlates with a
// JSON/form content type, and bans a source that keeps probing.
//
// Combines: body-region narrowing with after(), a content-type correlation
// subroutine, a payload detector subroutine, per-flow escalation, console(), and
// drop/ban. Request side on a gateway (dport 80/443).
nocase;
pattern sep = "\r\n\r\n";                              // header/body boundary
pattern p1 = "__proto__", p2 = "constructor.prototype", p3 = "constructor[", p4 = "prototype[";
pattern jsonct = "content-type: application/json", formct = "content-type: application/x-www-form";

// is this a body we should parse strictly? (JSON or form posts)
fn parseable_body() { if (any(scan(payload, 400), jsonct, formct)) return 1; return 0; }

// does the region at pointer `b` carry a prototype-pollution key?
fn body_pollutes(b) { if (any(scan(b, 1400), p1, p2, p3, p4)) return 1; return 0; }

filter {
  if (proto != 6) decide pass;
  if (dport != 80 && dport != 443) decide pass;
  if (len == 0) decide pass;
  if (!parseable_body()) decide pass;                  // only strict-parsed bodies matter

  // after() needs the separator located first; parseable_body()'s scan set it
  if (body_pollutes(after(sep))) {
    let hits = flow.count;
    console("prototype pollution dport=%d hit=%d", dport, hits);
    log(1);
    if (hits >= 5) decide ban("proto_pollution_flood", 1800);
    decide drop("proto_pollution");
  }
  decide pass;
}
