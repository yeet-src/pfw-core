// User-Agent allowlist (default-deny). For a locked-down API or admin surface, it
// is safer to permit only the clients you expect than to blocklist the bad ones. A
// subroutine decides whether the request carries a known-good User-Agent (browsers,
// your own client, common HTTP libraries); anything else — including a missing UA —
// is treated as suspicious, reset, and banned if it keeps coming. Internal source
// ranges are trusted and skip the check.
//
// Combines: reassembly, a subroutine returning a boolean over one scan, an inline
// CIDR trust check (src in "10.0.0.0/8"), per-connection strikes, console(), and
// rst -> ban escalation.
nocase;
reassemble 8080;
pattern mozilla = "mozilla/", curl = "curl/", appcli = "myapp-client/";
pattern okhttp = "okhttp/", chrome = "chrome/", python_req = "python-requests/";

fn allowed() {
  mask m = scan(payload, 1024);
  if (any(m, mozilla, curl, appcli)) return 1;
  if (any(m, okhttp, chrome, python_req)) return 1;
  return 0;
}

filter {
  if (proto != 6) return pass;
  if (dport != 80) return pass;
  if (len == 0) return pass;

  if (src in "10.0.0.0/8") return pass;   // internal clients are trusted
  if (allowed()) return pass;             // known-good User-Agent

  let strikes = flow.count;
  log(9);
  console("ua not allowlisted strikes=%d sport=%d", strikes, sport);
  if (strikes >= 5) return ban("bad_ua", 1800);
  return rst("bad_ua", 0);
}
