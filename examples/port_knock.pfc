// In-band knocking as a per-connection state machine (match on flow.state). The
// service on :7000 stays locked until the client sends a secret sequence of
// markers IN ORDER, each as its own segment; a wrong or out-of-order marker is
// dropped and does not advance. After the third knock the connection is open and
// everything on it passes. Each rung carries a TTL, so the sequence has to be
// completed promptly, and the open state is refreshed by traffic and lapses
// after five idle minutes.
//
// This is per CONNECTION (the state lives in the flow). It hides the service
// from a scanner that connects and speaks the real protocol; it is not a secret
// against anyone who can read the traffic, since the markers are sent in clear.
// Per packet, not reassembled — see fsm.pfc for why.
//
// Shows: flow.state advancing one rung per packet with a TTL, match() dispatch.
pattern k1 = "KNOCK-ALPHA", k2 = "KNOCK-BRAVO", k3 = "KNOCK-CHARLIE";
filter {
  if (proto != 6) decide pass;
  if (dport != 7000) decide pass;
  if (len == 0) decide pass;                         // handshake / pure ACKs
  match (flow.state) {
    case 0 { if (starts(payload, k1)) { flow.state = 1 for 20; decide pass; } decide drop("knock_1"); }
    case 1 { if (starts(payload, k2)) { flow.state = 2 for 20; decide pass; } decide drop("knock_2"); }
    case 2 { if (starts(payload, k3)) { flow.state = 3 for 300; decide pass; } decide drop("knock_3"); }
    case 3 { flow.state = 3 for 300; decide pass; }  // open: refresh the idle timer
    default { decide drop("knock_bad"); }
  }
}
