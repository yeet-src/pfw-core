// HTTP/2 role-based access control. `decode h2` HPACK-decodes each completed
// request header block (Huffman and the dynamic table included), so the matcher
// sees the pseudo-headers as plaintext lines — ":method: POST\n:path: /admin/x\n".
// The rules below are method x path policy on that view: no mutating method
// against an /admin path, /internal only from trusted networks, and a Bearer
// token required to write to /api/ — gateway policy applied without a proxy.
//
// The view holds the header blocks completed by ONE packet. That is one request
// in the common case; when a client packs several requests into one packet their
// lines are matched together, so these rules can only over-block, never miss.
// Plaintext HTTP/2 (h2c) only — TLS-wrapped h2 is ciphertext at XDP.
//
// Combines: the h2 decode stage, one scan over the decoded headers, any() across
// method/path pseudo-headers, and CIDR membership.
nocase;
decode h2 8080;
pattern x_post = ":method: post", x_put = ":method: put", x_del = ":method: delete";
pattern x_admin = ":path: /admin", x_internal = ":path: /internal", x_api = ":path: /api/";
pattern x_bearer = "authorization: bearer ";
filter {
  if (len == 0) decide pass;                  // nothing decoded in this packet
  mask m = scan(payload, 2048);

  if (any(m, x_admin)) {
    if (any(m, x_post, x_put, x_del)) { log(1); decide rst("h2_admin_write", 0); }
  }
  if (any(m, x_internal)) {
    if (src in "10.0.0.0/8") decide pass;
    decide drop("h2_internal_external");
  }
  if (any(m, x_api)) {
    if (any(m, x_post, x_put, x_del)) {
      if (any(m, x_bearer)) { count("h2_api_authed"); decide pass; }
      decide rst("h2_api_noauth", 0);
    }
  }
  decide pass;
}
