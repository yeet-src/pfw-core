// DNS-over-HTTPS detection — restore DNS visibility that DoH deliberately hides.
// On the web ports we look for the RFC 8484 tells in the (reassembled) request:
// the DoH media type `application/dns-message` (strong), the `/dns-query` well-known
// path, or the base64 `?dns=` GET form. Policy is shadow-aware: observe while
// tuning, then enforce by resetting confirmed DoH so clients fall back to visible
// DNS your resolver policy controls.
//
// Combines: reassembly, nocase, a subroutine returning a confidence tier,
// any()/scan, %shadow-gated enforcement, console().
nocase;
reassemble 443;
pattern dmsg = "application/dns-message", dpath = "/dns-query", dget = "?dns=";

fn doh_tier() {
  mask m = scan(payload, 1460);
  if (any(m, dmsg)) return 2;          // the DoH content type — high confidence
  if (any(m, dpath, dget)) return 1;   // the path / GET form
  return 0;
}

filter {
  if (dport != 443) { if (dport != 80) decide pass; }
  let tier = doh_tier();
  if (tier == 0) decide pass;

  console("DoH detected tier=%d dport=%d", tier, dport);
  log(1);
  if (shadow == 1) decide pass;        // observe-only while rolling out
  if (tier == 2) decide rst("doh_block", 0);
  decide pass;                         // tier 1 is logged but allowed
}
