// A passive tap (no blocking): tag traffic with counters and events for the
// userspace side to read, without ever changing a verdict.
//
// `count("name");` as a *statement* bumps a named counter and keeps going;
// `return count("name");` is the *verdict* form (tally, then stop). `log(n)`
// pushes an event onto the ring buffer. A program that never drops/resets is a
// pure observer — useful for measuring a rule before you arm it.
nocase;
pattern bot = "GPTBot", claudebot = "ClaudeBot";
filter {
  if (proto != 6) return pass;

  if (dport == 443) count("https");    // statement: tally and continue
  if (dport == 80) count("http");

  if (scan(payload, 1460) & (bot | claudebot)) {
    log(7);                            // event: "saw an AI crawler"
    return count("ai_crawler");        // verdict: tally this one, then stop
  }
  return pass;
}
