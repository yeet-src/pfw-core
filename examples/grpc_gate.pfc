// Gate gRPC methods over HTTP/2. `decode h2` HPACK-decodes the reassembled stream
// so the matcher sees the :path ("/package.Service/Method") in plaintext. A
// restricted service is allowed only when the call carries an Authorization bearer
// token; unauthenticated restricted calls escalate to a ban, and the whole
// connection is stream-flood throttled (cf. HTTP/2 rapid-reset, CVE-2023-44487).
//
// Combines: the h2 decode front-end, a classification subroutine, an auth check,
// rate(), flow.count escalation, and log()/console().
nocase;
decode h2 50051;
pattern admin = "/admin.adminservice/", reflect = "/grpc.reflection.", debugv = "/debug.", bearer = "authorization: bearer ";

fn restricted(p) {
  mask m = scan(p, 2048);
  if (any(m, admin, debugv)) return 1;    // admin / debug RPCs
  if (any(m, reflect)) return 1;          // server reflection = schema disclosure
  return 0;
}

filter {
  if (rate(100, 200)) { log(3); return drop("grpc_flood"); }

  if (restricted(payload)) {
    if (scan(payload, 2048) & bearer) return pass;   // authenticated call: allow
    let strike = flow.count;
    console("grpc restricted unauth strike=%d", strike);
    if (strike >= 5) return ban("grpc_abuse", 1800);
    return drop("grpc_restricted");
  }
  return pass;
}
