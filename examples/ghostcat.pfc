// GhostCat (CVE-2020-1938): Tomcat AJP Connector file read / RCE. AJP13 packets
// begin with the magic bytes 0x12 0x34; the attack injects the
// `javax.servlet.include.*` request attributes so Tomcat includes an arbitrary
// file (config/secrets, or an uploaded JSP for RCE). The AJP connector (1:8009)
// should never face the internet, so its magic on an exposed port is itself a
// red flag; the include-attribute names confirm exploitation.
//
// Non-trivial: anchors the AJP magic at the packet start, scores the include-
// attribute abuse, and escalates. Binary protocol — no reassembly.
nocase;
pattern ajp = {0x12, 0x34};
pattern inc_uri = "javax.servlet.include.request_uri";
pattern inc_path = "javax.servlet.include.path_info";
pattern inc_sp = "javax.servlet.include.servlet_path";

fn score() {
  mask m = scan(payload, 1024);
  let s = 0;
  if (starts(payload, ajp)) s = s + 1;               // AJP13 framing
  if (any(m, inc_uri, inc_path, inc_sp)) s = s + 3;  // include-attribute LFI
  return s;
}

filter {
  if (proto != 6) decide pass;
  if (dport == 8009) log(2);            // AJP exposed at all is worth noting
  let s = score();
  if (s >= 3) {
    log(1);
    if (flow.count >= 1) decide ban("ghostcat", 7200);
    decide rst("ghostcat", 0);
  }
  decide pass;
}
