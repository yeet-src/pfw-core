// Subroutines with arguments and a return value. The calling convention:
//   - args go in %a0..%a6 (up to 7); a param name aliases its arg register,
//   - the return value comes back in %rv, so a call is usable as a value
//     (`let r = f(x);`, `if (f(x)) ...`, `if (f(x) == k) ...`),
//   - routines are caller-saved over a0..a6/rv and share the data stack, so keep
//     the stack balanced across a call and save anything you need past a nested call.
//
// Args are untyped 64-bit values: pass integers, ports, IPs, lengths, flags — or
// PACKET POINTERS (payload, after(pat), find(...)), so a routine can scan/load
// from a pointer it's handed. Here one routine scans an arbitrary region for
// scanner signatures and returns a boolean, reused on two different pointers.
nocase;
reassemble 8080;
pattern sqlmap = "sqlmap", nikto = "nikto";
pattern host = "host:";

fn has_scanner(ptr) {           // ptr: a packet pointer to scan from
  rv = 0;
  if (any(scan(ptr, 1024), sqlmap, nikto)) rv = 1;   // scan length is a constant
}

filter {
  if (dport != 80) return pass;
  if (has_scanner(payload)) return ban("scanner_body", 3600);    // scan the request
  if (has_scanner(after(host))) return ban("scanner_host", 3600); // scan just past Host:
  return pass;
}
