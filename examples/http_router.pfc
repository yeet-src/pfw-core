// HTTP method x path RBAC router. Parses the request line with the cursor, then
// applies per-route policy: a subroutine classifies the source as internal, admin
// and internal paths are reachable only from internal CIDRs, and writes to /api
// require an Authorization header. A real router's access rules, enforced at XDP
// before the request ever reaches the app.
//
// Combines: reassembly, cursor request-line parse (find/skip/starts), a fn that
// returns a value in %rv, CIDR membership, and seq/any over one scan.
nocase;
reassemble 80;
pattern m_get = "GET ", m_post = "POST ", m_put = "PUT ", m_del = "DELETE ", m_trace = "TRACE ";
pattern p_admin = "/admin", p_internal = "/internal", p_api = "/api/";
pattern h_auth = "authorization:";

fn internal_src() {                         // 1 if the source is on a trusted net
  if (src in "10.0.0.0/8") return 1;
  if (src in "192.168.0.0/16") return 1;
  if (src in "127.0.0.0/8") return 1;
  return 0;
}

filter {
  if (proto != 6) decide pass;
  if (dport != 80) decide pass;
  if (len == 0) decide pass;

  if (starts(payload, m_trace)) decide drop("trace_method");   // leaks internals

  // advance the cursor to the path: first space, then skip the run of spaces
  ptr path = find(payload, ' ', 8);
  skip(path, ' ');

  // admin / internal surfaces: trusted sources only
  if (starts(path, p_admin)) {
    if (internal_src()) { count("admin_ok"); decide pass; }
    log(1); decide rst("admin_from_outside", 0);
  }
  if (starts(path, p_internal)) {
    if (internal_src()) decide pass;
    decide drop("internal_from_outside");
  }

  // mutating API calls must carry an Authorization header
  if (starts(path, p_api)) {
    if (starts(payload, m_post) || starts(payload, m_put) || starts(payload, m_del)) {
      if (scan(payload, 1024) & h_auth) { count("api_write_authed"); decide pass; }
      log(1); decide rst("api_write_noauth", 0);
    }
  }
  count("routed");
  decide pass;
}
