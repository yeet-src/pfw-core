// XML External Entity (XXE): a DOCTYPE that declares an external ENTITY pointing at
// a SYSTEM resource lets an attacker read local files or reach internal services
// (SSRF) through an XML parser. We require the attack's *structure* — a DOCTYPE and
// an ENTITY and a SYSTEM/PUBLIC external reference — rather than any one keyword, so
// ordinary XML that merely mentions "system" doesn't trip. A file:/php:// wrapper or
// an http(s):// target (SSRF-via-XXE) raises the score to an outright ban.
//
// Combines: reassembly, nocase, a reused mask, all()/any() structural tests, a
// scoring subroutine, arithmetic, flow.count escalation, console/log.
nocase;
reassemble 8080;
pattern doctype = "<!doctype", entity = "<!entity", system = "system", public = "public";
pattern w_file = "file:/", w_php = "php://", w_expect = "expect://", w_jar = "jar:";
pattern t_http = "http://", t_https = "https://", t_gopher = "gopher://";
pattern param_ent = "<!entity %";                   // parameter-entity (blind/OOB XXE)

fn xxe_score() {
  mask m = scan(payload, 2048);
  let s = 0;
  if (all(m, doctype, entity) && any(m, system, public)) s = s + 2;   // the XXE shape
  if (any(m, param_ent)) s = s + 1;                                    // parameter entities (OOB)
  if (any(m, w_file, w_php, w_expect, w_jar)) s = s + 2;              // local file / RCE wrappers
  if (any(m, t_http, t_https, t_gopher) && all(m, doctype, entity)) s = s + 2; // SSRF via entity
  return s;
}

filter {
  if (proto != 6) return pass;
  if (dport != 80) return pass;

  let score = xxe_score();
  if (score < 2) return pass;                 // need the structure, not a stray keyword
  console("xxe score=%d sport=%d", score, sport);
  log(1);
  if (score >= 4) return ban("xxe_exfil", 3600);
  if (flow.count >= 2) return ban("xxe_repeat", 3600);
  return drop("xxe");
}
