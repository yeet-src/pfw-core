// Evasion-resistant path-traversal detector. Attackers hide "../" behind percent-
// and overlong-encodings (%2e%2e, %2f, double-encoded %252e, overlong %c0%ae) to
// slip past naive string matches. Two layers: one scan matches the whole battery
// of encodings at once, then a bounded loop walks the URL path segment by segment
// (splitting on '/', starts()-disambiguated so adjacent "//" is handled) and flags
// any segment that *begins* with ".." — so even a novel encoding that normalizes
// to a dot-dot segment is caught structurally.
nocase;
reassemble 8080;
pattern e_dot = "%2e", e_slash = "%2f", e_dbl = "%252e", e_over = "%c0%ae", e_bslash = "%5c";
pattern dd = "..", slash = "/";
filter {
  if (dport != 80) decide pass;
  if (any(scan(payload, 1024), e_dot, e_slash, e_dbl, e_over, e_bslash)) { log(1); decide drop("encoded_traversal"); }
  let big = 1000000;
  ptr p = find(payload, ' ', 8); skip(p, ' ');     // step over the method to the URI
  repeat (32) {
    let o = find(p, '/', 1024);
    if (o == p) { if (!starts(p, slash)) o = big; }
    if (o < big) { p = o + 1; if (starts(p, dd)) decide drop("path_traversal"); }
  }
  decide pass;
}
