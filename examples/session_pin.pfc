// Session pinning / hijack detection (behavioral). The first request on a
// connection establishes a fingerprint; every later packet must present the same
// one, or the session has been taken over mid-stream. Here the fingerprint is
// stashed on the per-flow ring on the first data segment and compared thereafter.
// (The template pins the source port; in production pin a cookie/token hash —
// anything the client holds that a hijacker can't reproduce.)
//
// Cross-packet: flow.state marks "fingerprint taken", the ring holds it.
reassemble 8080;
filter {
  if (proto != 6) decide pass;
  if (len == 0) decide pass;
  match (flow.state) {
    case 0 {
      ring.push(sport);                        // pin the fingerprint
      flow.state = 1 for 600;
      decide pass;
    }
    default {
      if (ring.len == 0) decide pass;
      if (ring.get(0) != sport) { log(1); decide rst("session_hijack", 0); }
      decide pass;
    }
  }
}
