// SYN-flood / half-open defence. A bare-SYN storm tries to exhaust the backlog:
// many SYNs that never complete the handshake. We read the TCP flags, isolate the
// opening SYN (SYN set, ACK clear), cap the SYN rate with a token bucket, and
// track the half-open state per flow — a connection that keeps re-SYNing without
// ever sending data is escalated from a drop to a source-wide ban. A real data
// segment clears the suspicion.
//
// Header read: TCP flags at l4+13. Combines a subroutine, bitfield flag tests,
// rate() limiting, a flow.state half-open machine, flow.count escalation, ban.
filter {
  if (proto != 6) decide pass;

  let fl = 0;
  frame at (l4) (len = u8 @ 13, head = 20) up to 1 { fl = frame.len; }

  if (is_opening_syn(fl)) {
    // a source that has re-SYNed this flow many times is flooding, not retrying
    if (flow.count >= 6) decide ban("syn_flood", 600);
    // cap the rate of new SYNs; drop the excess
    if (rate(20, 40)) { log(1); decide drop("syn_rate"); }
    flow.state = 1 for 10;                    // arm "half-open" for 10s
    decide pass;
  }

  // any non-SYN segment (data / the completing ACK) means the handshake is making
  // progress — clear the half-open mark so this flow isn't counted against us.
  if (flow.state == 1) flow.state = 0 for 1;
  decide pass;
}

fn is_opening_syn(fl) {
  let s = fl & 2;
  let a = fl & 16;
  if (s == 2) { if (a == 0) return 1; }
  return 0;
}
