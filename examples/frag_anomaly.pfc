// IP fragmentation attacks (teardrop / tiny-fragment / illegal flag combos). The
// IPv4 flags+offset word (l3+6) and total-length (l3+2) expose the classic abuses:
// MF and DF set together (impossible), a tiny first fragment used to push the L4
// header into a second fragment past a filter, and small non-zero offsets that
// overlap on reassembly (teardrop). We classify the anomaly and escalate a
// repeat offender to a ban.
//
// Header reads: IP flags/frag-offset (be16 @ l3+6) and total length (be16 @ l3+2).
// Combines a subroutine returning a class, bitfield extraction, console(), and
// flow.count escalation.
filter {
  let ff = 0;
  let tl = 0;
  frame at (l3) (len = be16 @ 6, type = be16 @ 2, head = 20) up to 1 { ff = frame.len; tl = frame.type; }

  let cls = frag_class(ff, tl);
  if (cls == 0) decide pass;

  console("frag anomaly class=%d flagsoff=%d totlen=%d", cls, ff, tl);
  log(1);
  if (flow.count >= 3) decide ban("frag_repeat", 600);
  decide drop("ip_frag_anomaly");
}

// 1 = MF+DF (illegal), 2 = tiny first fragment, 3 = small overlapping offset.
fn frag_class(ff, totlen) {
  let mf = ff & 8192;        // 0x2000 more-fragments
  let df = ff & 16384;       // 0x4000 don't-fragment
  let off = ff & 8191;       // 0x1fff fragment offset (8-byte units)
  if (mf == 8192) { if (df == 16384) return 1; }
  if (mf == 8192) { if (off == 0) { if (totlen < 48) return 2; } }
  if (off > 0) { if (off < 8) return 3; }
  return 0;
}
