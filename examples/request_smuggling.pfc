// HTTP request smuggling (CL.TE / TE.CL). When a front-end proxy and the backend
// disagree on where a request ends, an attacker can smuggle a second request
// past the proxy's checks. The classic tells: a request carrying BOTH
// Transfer-Encoding and Content-Length, or an obfuscated Transfer-Encoding header
// ("Transfer-Encoding :", underscores, duplicate) crafted so one parser honors it
// and the other doesn't.
//
// Combines: reassembly, nocase, a subroutine that classifies the request over one
// scan with all()/any()/seq(), console() observability, and drop.
nocase;
reassemble 8080;
pattern te = "transfer-encoding:", cl = "content-length:", chunked = "chunked";
pattern te_sp = "transfer-encoding :", te_us = "transfer_encoding", te_tab = "transfer-encoding\t";
pattern post = "post ", smuggle = "content-length: 0";

// 2 = both framing headers (CL.TE/TE.CL), 1 = obfuscated Transfer-Encoding
fn classify() {
  mask m = scan(payload, 2048);
  if (all(m, te, cl) && any(m, chunked)) return 2;
  if (seq(m, post, smuggle) && any(m, chunked)) return 2;
  if (any(m, te_sp, te_us, te_tab)) return 1;
  return 0;
}

filter {
  if (proto != 6) decide pass;
  if (dport != 80) decide pass;

  let kind = classify();
  if (kind == 0) decide pass;

  log(3);
  console("smuggling kind=%d sport=%d", kind, sport);
  if (kind == 2) decide drop("http_smuggling");     // ambiguous framing: refuse
  if (flow.count >= 2) decide ban("smuggle_probe", 1800);
  decide rst("te_obfuscated", 0);
}
