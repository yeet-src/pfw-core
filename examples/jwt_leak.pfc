// JWTs belong in the Authorization header — not in URLs, query strings, or cookies,
// where they bleed into access logs, Referer headers, and browser history. This
// spots a JWT in a request (the "eyJ..." base64 of a `{"alg":` / `{"typ":` header),
// then decides by WHERE it is: inside Authorization is fine and passes quietly;
// anywhere else is a token leak, logged with the port and counted per flow. It
// observes rather than blocks — breaking auth is worse than the leak — but bans a
// flow that floods tokens (a scraper harvesting them).
//
// Combines: two detector subroutines (token present / inside Authorization),
// a decision that correlates the two, per-flow escalation, and console() telemetry.
// Request side on a gateway (dport 80/443).
nocase;
pattern jwt1 = "eyjhbgci", jwt2 = "eyj0exai", jwt3 = "eyjraw";   // base64 of JWT headers
pattern authz = "authorization:";

fn jwt_present() { if (any(scan(payload, 480), jwt1, jwt2, jwt3)) return 1; return 0; }
fn has_authz()   { if (any(scan(payload, 480), authz)) return 1; return 0; }

filter {
  if (proto != 6) decide pass;
  if (dport != 80 && dport != 443) decide pass;
  if (!jwt_present()) decide pass;

  // a JWT WITH an Authorization header is almost certainly the header itself: ok
  if (has_authz()) { count("jwt_in_header"); decide pass; }

  // a JWT with NO Authorization header => it's in the URL / cookie / body: a leak
  let hits = flow.count;
  console("jwt leaked outside Authorization dport=%d hit=%d", dport, hits);
  log(3);
  if (hits >= 10) decide ban("jwt_harvest", 600);   // flood of tokens: likely harvesting
  decide pass;                                        // otherwise observe, don't break auth
}
