// NoSQL (MongoDB) operator-injection filter. When an app passes request data into
// a Mongo query, attacker-supplied operators like {"$ne":null} or {"$gt":""} or
// {"$where":"..."} turn a lookup into an auth bypass or server-side JS execution.
// This scores a request on several operator signatures plus the JS-exec operators,
// and escalates: a reset for a light hit, an immediate ban when the dangerous
// $where/$function/mapReduce operators appear (those run code).
//
// Combines: one reassembled scan into a reused mask, multi-signal scoring with
// arithmetic, a subroutine returning a score, severity tiers, escalation, console().
nocase;
reassemble 8080;
pattern o_where = "$where", o_ne = "$ne", o_gt = "$gt", o_lt = "$lt";
pattern o_regex = "$regex", o_in = "$in", o_func = "$function", o_mapreduce = "mapreduce";
pattern enc_ne = "[$ne]", enc_gt = "%24ne";

// A weighted injection score over one scan. $where/$function execute code (heavy).
fn nosql_score() {
  mask m = scan(payload, 1460);
  let s = 0;
  if (any(m, o_ne, o_gt, o_lt, o_regex, o_in)) s = s + 1;    // operator smell
  if (any(m, enc_ne, enc_gt)) s = s + 1;                     // url-encoded operator
  if (any(m, o_where, o_func, o_mapreduce)) s = s + 5;       // code execution
  return s;
}

filter {
  if (proto != 6) decide pass;
  if (dport != 80) decide pass;
  if (len == 0) decide pass;

  let score = nosql_score();
  if (score == 0) decide pass;

  console("nosqli score=%d sport=%d strikes=%d", score, sport, flow.count);
  log(1);
  if (score >= 5) decide ban("nosqli_codeexec", 3600);       // $where etc. — ban now
  if (flow.count >= 3) decide ban("nosqli_repeat", 1800);    // persistent prober
  decide rst("nosqli", 0);
}
