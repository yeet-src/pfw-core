// SSH (:22) brute-force mitigation. Known brute tools announce themselves in the
// client banner (libssh/paramiko) and are banned on sight. Otherwise, SSH auth is a
// handful of packets — a sustained segment flood on one connection is a password
// spray, so it is rate-limited, and a connection that keeps flooding escalates to a
// source ban (later packets are then dropped before this program even runs).
//
// Combines: reassembly, a banner scan, rate(), a fn returning an escalation
// decision, flow.count, and console()/log().
reassemble 22;
pattern libssh = "libssh", paramiko = "paramiko", paramik2 = "Paramiko";

fn offender() {
  if (flow.count >= 30) return 1;
  return 0;
}

filter {
  if (dport != 22) return pass;
  if (len == 0) return pass;

  if (any(scan(payload, 128), libssh, paramiko, paramik2)) { log(1); return ban("ssh_tool", 3600); }

  if (rate(8, 16)) {
    console("ssh flood sport=%d", sport);
    if (offender()) return ban("ssh_bruteforce", 1800);
    return drop("ssh_ratelimit");
  }
  return pass;
}
