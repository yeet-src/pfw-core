// Insecure deserialization: untrusted serialized objects reaching a language's
// native deserializer is a reliable RCE primitive (Java ysoserial, Python pickle,
// PHP object injection, .NET BinaryFormatter). We fingerprint the wire formats by
// their magic bytes and markers across both raw and base64 transport: a hit is
// high-signal, so native-format magic bytes ban the source immediately, while the
// softer textual markers are scored and escalated.
//
// Combines: reassembly, raw byte-sequence patterns ({0x..}), base64-transport
// prefixes, a scoring subroutine, any() across language formats, arithmetic,
// flow.count escalation, console/log.
reassemble 8080;
pattern java_magic = {0xac, 0xed, 0x00, 0x05};       // Java ObjectStream header
pattern java_b64 = "rO0AB";                           // base64 of ac ed 00 05
pattern php_obj = "O:", php_arr = "a:";               // PHP serialized object/array headers
pattern net_bf = "AAEAAAD/////";                      // .NET BinaryFormatter base64 preamble
pattern py_pickle = {0x80, 0x04};                     // pickle protocol 4 opcode (PROTO 4)
pattern py_c = "c__builtin__", py_posix = "cposix", py_os = "nt\nsystem";
pattern gadget_cc = "commonscollections", gadget_tmpl = "templatesimpl";

fn deser_score() {
  mask m = scan(payload, 2048);
  let s = 0;
  if (any(m, java_magic, py_pickle)) s = s + 3;              // raw native magic: near-certain
  if (any(m, java_b64, net_bf)) s = s + 2;                    // base64-wrapped native object
  if (any(m, py_c, py_posix, py_os)) s = s + 2;              // pickle global-import to code exec
  if (any(m, gadget_cc, gadget_tmpl)) s = s + 2;             // known gadget-chain class names
  if (any(m, php_obj, php_arr)) s = s + 1;                    // PHP object injection (noisier)
  return s;
}

filter {
  if (proto != 6) decide pass;
  if (dport != 80) decide pass;

  let score = deser_score();
  if (score < 2) decide pass;
  console("deser score=%d sport=%d strikes=%d", score, sport, flow.count);
  log(1);
  if (score >= 3) decide ban("deserialization_rce", 7200);   // native magic / gadget chain
  if (flow.count >= 2) decide ban("deser_repeat", 7200);
  decide drop("deserialization");
}
