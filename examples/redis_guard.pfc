// Protect an exposed Redis (:6379) with an AUTH state machine + command policy.
// Redis speaks RESP (plaintext tokens) and, classically, has no auth until AUTH is
// sent — so an open instance is a one-command breach. Here: until a connection has
// issued AUTH, a dangerous command is treated as an unauthenticated attacker and
// bans the source; once authenticated, destructive verbs are still blocked and
// command floods throttled with per-connection escalation.
//
// Combines: reassembly, a classification subroutine, a flow.state AUTH gate, a
// single-pattern mask test, rate(), flow.count escalation, console()/log().
nocase;
reassemble 6379;
pattern authcmd = "auth ";
pattern flushall = "flushall", flushdb = "flushdb", shutdown = "shutdown";
pattern config = "config", debugc = "debug", module = "module load", slaveof = "slaveof";
pattern keysall = "keys *", scriptc = "script load";

fn is_dangerous(p) {
  mask m = scan(p, 512);
  if (any(m, flushall, flushdb, shutdown)) return 1;   // destructive
  if (any(m, config, debugc, module, slaveof)) return 1; // reconfig / RCE vectors
  if (any(m, keysall, scriptc)) return 1;               // DoS / lua
  return 0;
}

filter {
  if (dport != 6379) return pass;
  if (len == 0) return pass;

  if (flow.state == 0) {                      // not yet authenticated on this conn
    if (scan(payload, 128) & authcmd) { flow.state = 1 for 600; return pass; }
    if (is_dangerous(payload)) { console("unauth redis cmd sport=%d", sport); return ban("redis_unauth", 3600); }
    return pass;
  }

  if (is_dangerous(payload)) {                // authenticated, but still guarded
    let strike = flow.count;
    if (strike >= 3) return ban("redis_repeat", 1800);
    log(1);
    return drop("redis_dangerous");
  }
  if (rate(200, 400)) return drop("redis_flood");
  return pass;
}
