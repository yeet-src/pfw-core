// Credential/secret scanner in either direction: a request shipping a key to a
// third party, or a response leaking one from a config page, a stack trace, or a
// debug endpoint. Each secret class is its own subroutine so the set is easy to
// extend; a hit is logged with which class fired, counted per flow, and a source
// that trips several times is banned (a scraper walking an exposed /.git or
// /config).
//
// Combines: a fixed-length regex (AWS key) + literal detectors, one subroutine per
// secret class returning a class code, per-flow escalation, and console() with the
// class in the message. Bidirectional (no dport/sport guard — secrets leak both ways).
nocase;
regex awskey = "AKIA[A-Z0-9]{16}";            // AWS access key id
pattern slackb = "xoxb-", slackp = "xoxp-";   // Slack bot/user tokens
pattern ghp = "ghp_", ghpat = "github_pat_";  // GitHub tokens
pattern rsa = "-----begin rsa private key", pgp = "-----begin openssh private key";
pattern jwt = "eyJhbgci", gcp = "-----begin private key";

// return a nonzero class code for the kind of secret seen, else 0
fn classify_secret() {
  mask m = scan(payload, 1460);
  if (any(m, awskey)) return 1;                 // cloud key
  if (any(m, slackb, slackp)) return 2;         // chat token
  if (any(m, ghp, ghpat)) return 3;             // vcs token
  if (any(m, rsa, pgp, gcp)) return 4;          // private key material
  if (any(m, jwt)) return 5;                    // bearer/JWT
  return 0;
}

filter {
  if (proto != 6) return pass;
  if (len == 0) return pass;

  let klass = classify_secret();
  if (klass > 0) {
    let hits = flow.count;
    console("secret class=%d dport=%d hit=%d", klass, dport, hits);
    log(1);
    if (hits >= 2) return ban("secret_repeat", 3600);   // sweeping for keys: ban
    return rst("secret_leak", 0);
  }
  return pass;
}
