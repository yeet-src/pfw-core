// Exfiltration tripwire. A unique canary token is planted in the sensitive store
// (a fake row in the users table, a bait document, a honey API key). It should
// never appear in normal traffic — so if it shows up in a RESPONSE, something read
// the store it was hiding in, and the source on the other end is exfiltrating.
// This is a high-signal, near-zero-false-positive detector: one hit bans the
// source for a day and shouts on the console. It also catches the token in a
// REQUEST (someone replaying stolen data back in).
//
// Combines: a detector subroutine, flow.state to fire the alarm once per connection
// (then kill the rest of the flow), console() with the offending region via %s, and
// a long source ban. Gateway, both directions.
nocase;
pattern tok = "cnry-7f3a9e2b1d4c6f8a05";    // the planted canary (unique, non-guessable)

// true if the token appears anywhere in this segment (request or response)
fn canary_seen() { if (any(scan(payload, 1460), tok)) return 1; return 0; }

filter {
  if (proto != 6) decide pass;
  if (len == 0) decide pass;
  if (flow.state == 1) decide drop("canary_flow");   // already tripped: kill the rest

  if (canary_seen()) {
    flow.state = 1 for 86400;                         // remember this flow is burned
    log(9);
    // the token's neighbourhood often shows what was dumped — ship it to userspace
    console("CANARY TRIPPED sport=%d dport=%d ctx=%s", sport, dport, after(tok));
    decide ban("canary_exfil", 86400);               // ban the source for a day
  }
  decide pass;
}
