// LDAP (:389) filter-injection + bind-abuse guard. Attacker-controlled input that
// breaks out of an LDAP search filter with )( and wildcards can bypass auth or dump
// the directory; a subroutine matches the classic injection shapes and escalates
// repeat offenders. Separately, a storm of bind requests on one connection is
// credential spraying and is rate-limited.
//
// Combines: reassembly, a multi-pattern injection subroutine, flow.count
// escalation, a single-pattern mask test, rate(), and console()/log().
nocase;
reassemble 389;
pattern inj1 = ")(uid=*", inj2 = ")(|(", inj3 = "*)(&", inj4 = "admin)(&", inj5 = ")(cn=*", inj6 = "*))%00";
pattern bindreq = "bindrequest";

fn injection(p) {
  mask m = scan(p, 1024);
  if (any(m, inj1, inj2, inj3)) return 1;
  if (any(m, inj4, inj5, inj6)) return 1;
  return 0;
}

filter {
  if (dport != 389) return pass;

  if (injection(payload)) {
    let strike = flow.count;
    console("ldap injection strike=%d", strike);
    if (strike >= 3) return ban("ldap_injection_repeat", 3600);
    return drop("ldap_injection");
  }

  if (scan(payload, 256) & bindreq) {
    if (rate(5, 10)) return drop("ldap_bind_flood");
  }
  return pass;
}
