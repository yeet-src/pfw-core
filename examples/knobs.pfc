// Live control plane with knobs. A knob is a named value the host sets in the
// `knobs` map and can rewrite AT ANY TIME; the program reads it per packet, so an
// operator drives the running filter without recompiling or reloading — flip a
// rule on, retune a threshold, switch modes, all live. `knob("name") ?? d` seeds
// an initial value d at load (overridable later, even to 0 — 0 is a real value,
// not "unset"). Unlike argv (positional, baked into the program at load), knobs
// are named and live.
//
// Host side:  setKnob(control, "block_scanners", 1)   // turn the rule on, live
//             setKnob(control, "max_bytes", 4096)     // retune, live
//             setKnob(control, "mode", 2)             // 0=off 1=log 2=enforce
nocase;
reassemble 8080;
pattern sqlmap = "sqlmap", nikto = "nikto";

filter {
  if (dport != 80) decide pass;

  // A kill-switch + mode dial the operator controls in real time.
  let mode = knob("mode") ?? 2;                 // 0 off, 1 observe, 2 enforce
  if (mode == 0) decide pass;

  // Scanner rule, toggled from the host (default on).
  if (knob("block_scanners") ?? 1 == 1) {
    if (any(scan(payload, 1024), sqlmap, nikto)) {
      log(1);
      if (mode == 2) decide ban("scanner", 3600);   // enforce
      decide pass;                                    // observe-only: just logged
    }
  }

  // A tunable request-size cap (0 = no cap).
  let cap = knob("max_bytes") ?? 0;
  if (cap > 0 && len > cap) {
    log(2);
    if (mode == 2) decide drop("oversize");
  }
  decide pass;
}
